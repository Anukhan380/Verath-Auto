# Copy this file to ".env" (same folder) and fill in the values you need. Never share or commit your real .env.

# --- AI provider (server-side only; never sent to the browser). Use ONE key. ---
# Groq has a free tier (key starts with gsk_): https://console.groq.com/keys
GROQ_API_KEY=
# Optional Groq model overrides (Groq changes its model list from time to time; see console.groq.com/docs/models):
# VERATH_AI_MODEL=llama-3.3-70b-versatile
# VERATH_AI_VISION_MODEL=qwen/qwen3.6-27b
# OpenRouter (key starts with sk-or-): https://openrouter.ai/keys
# Default model "openrouter/free" lets OpenRouter pick a currently available free model (including ones that can read photos).
OPENROUTER_API_KEY=
# Use ONE key. If you set several, the order is Anthropic, then Groq, then OpenRouter. To force one: AI_PROVIDER=openrouter
# AI_PROVIDER=openrouter
# Anthropic Claude (key starts with sk-ant-). If both keys are set, Anthropic is used unless AI_PROVIDER=groq.

# Without a key the app still works: Car Advisor, Deal Analyzer, Comparison, Listing Assistant and the
# Dealer Assistant insights run on real marketplace data with fixed rules. Mechanic Assistant and
# Photo Inspection need a key and stay switched off (with a clear message) until you add one.
ANTHROPIC_API_KEY=

# --- Verath Auto Showroom contact details shown on showroom listings ---
VERATH_SHOWROOM_PHONE=0300 0000000
VERATH_SHOWROOM_WHATSAPP=0300 0000000

# PORT=3000

# --- Production only (set these as environment variables on your host, not in a file) ---
# DATA_DIR=/data            folder on the host's persistent disk (database, uploads, private files)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-password-at-least-10-characters   (used once to create the owner; remove afterwards)
# APP_URL=https://your-site.example.com
